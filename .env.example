# --- Local development ---
# Point straight at the backend; the browser talks to it directly.
NEXT_PUBLIC_API_URL=http://localhost:3050
NEXT_PUBLIC_SOCKET_URL=http://localhost:3050

# --- Production (Vercel), while the backend is still plain http:// ---
# A Vercel deployment is served over https, and browsers block "mixed content"
# (https page calling an http:// API/socket) — so instead of pointing straight
# at the backend, proxy REST calls through this app's own domain:
#
#   NEXT_PUBLIC_API_URL=/api
#   BACKEND_INTERNAL_URL=http://<real-backend-host>:<port>   (server-side only, no NEXT_PUBLIC_ prefix)
#
# next.config.mjs rewrites /api/* to BACKEND_INTERNAL_URL server-side, so the
# browser only ever talks to https://<this-app>.vercel.app/api/... — no mixed
# content. Sockets can't be proxied this way (long-lived connections don't
# work through Vercel's serverless functions), so NEXT_PUBLIC_SOCKET_URL still
# needs the backend reachable over https/wss directly — put a domain + SSL
# (Nginx/Caddy + Let's Encrypt, or Cloudflare) in front of the backend for
# real-time features to work once deployed.
#
# NEXT_PUBLIC_API_URL=/api
# BACKEND_INTERNAL_URL=http://168.231.67.56:3050
# NEXT_PUBLIC_SOCKET_URL=https://your-backend-domain.example.com
